              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1,\n  \"customer_email\": \"broken-race@example.com\",\n  \"order_number\": \"BROKEN-RACE-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{broken_base_url}}/orders",
            "description": "Создает заказ для конкурентной оплаты в broken-version."
          },
          "response": []
        },
        {
          "name": "Broken Race · Concurrent payment burst",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const orderId = pm.collectionVariables.get('broken_race_order_id');",
                  "const total = Number(pm.collectionVariables.get('concurrent_payment_requests') || 12);",
                  "const baseUrl = pm.collectionVariables.get('broken_base_url');",
                  "const statuses = [];",
                  "let completed = 0;",
                  "for (let i = 0; i < total; i++) {",
                  "  pm.sendRequest({",
                  "    url: `${baseUrl}/orders/${orderId}/payments`,",
                  "    method: 'POST'",
                  "  }, function (err, res) {",
                  "    completed++;",
                  "    statuses.push(err ? 'ERR' : String(res.code));",
                  "    if (completed === total) {",
                  "      pm.collectionVariables.set('broken_race_statuses', statuses.join(','));",
                  "      console.log('Broken concurrent payment statuses:', statuses.join(','));",
                  "    }",
                  "  });",
                  "}",
                  "pm.execution.setNextRequest('Broken Race · List payments');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{broken_base_url}}/orders/{{broken_race_order_id}}/payments",
            "description": "Технический запрос, внутри которого Postman одновременно отправляет несколько POST /payments."
